# Modèle de configuration — copiez vers .env.local
#
#   cp .env.example .env.local
#
# Next.js lit `.env.local` en priorité ; les scripts `db:*` lisent le même
# fichier. Aucun secret ne va dans Git : seuls les gabarits sont versionnés.

# ── Base de données (PostgreSQL direct) ─────────────────────────────
# Cible par défaut : le conteneur de docker-compose.yml (port 5433 en
# façade). En production, mettez ici l'URL fournie par l'hébergeur, avec
# `?sslmode=require` si le serveur l'exige. Les scripts db:* refusent
# d'effacer une base dont l'hôte n'est pas local.
DATABASE_URL=postgres://devnet:devnet@127.0.0.1:5433/devnet

# Certificat d'autorité du serveur, pour `sslmode=verify-full` : contenu PEM
# ou chemin d'un fichier. Sans lui, `require` chiffre sans prouver l'identité
# du serveur ; `disable` est refusé vers un hôte distant.
DATABASE_CA_CERT=

# Échappatoire explicite quand l'hébergeur n'offre pas TLS (Systalink annonce
# aujourd'hui « Mode SSL : disable »). À `true`, un hôte distant sans
# `sslmode` — ou avec `sslmode=disable` — se connecte en clair : le mot de
# passe traverse le réseau lisible. À n'activer qu'après l'échec constaté
# « The server does not support SSL connections », et à retirer dès que
# l'hébergeur propose TLS.
DATABASE_TLS_INSECURE=false

# local (défaut) ou remote. Une écriture distante exige en plus
# CONFIRM_REMOTE=<nom exact de la base>. Ne jamais mettre `remote` en CI.
DB_TARGET=local
CONFIRM_REMOTE=

# ── Drainage des événements (Phase 3) ───────────────────────────────
# Secret porteur du planificateur : Authorization: Bearer <valeur>.
# Sans ce secret, seul un utilisateur connecté peut déclencher le drainage.
EVENTS_DRAIN_SECRET=
# true coupe tous les plugins d'un coup, sans redéploiement.
PLUGINS_DISABLED=false

# ── Mode démonstration ──────────────────────────────────────────────
# true : l'application démarre sans backend, données en mémoire.
NEXT_PUBLIC_FORCE_DEMO=false

# ── OAuth GitHub (facultatif : seul le groupe /api/github en dépend) ─
NEXT_PUBLIC_GITHUB_CLIENT_ID=
# Secrets serveur uniquement.
GITHUB_CLIENT_SECRET=
# 32 caractères minimum ; chiffre le jeton GitHub dans le cookie.
GITHUB_CRYPT_KEY=
# Date ISO 8601 de fin de la période de grâce des anciens cookies (format v1).
GITHUB_CRYPT_LEGACY_UNTIL=2026-12-04T00:00:00.000Z

# ── Connexion OAuth Google / GitHub ────────────────────────────────
# Secrets serveur uniquement. Sans ces valeurs, /login affiche les boutons
# puis explique que la connexion externe n'est pas configurée.
# Callbacks à déclarer chez chaque fournisseur :
#   Google : https://<origine>/api/auth/oauth/google/callback
#   GitHub : https://<origine>/api/auth/oauth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OAuth App GitHub dédiée à la connexion (distincte de la liaison de dépôts).
GITHUB_LOGIN_CLIENT_ID=
GITHUB_LOGIN_CLIENT_SECRET=
# 32 caractères minimum ; signe le `state` OAuth (HMAC-SHA-256).
AUTH_OAUTH_SECRET=

# ── GIF ─────────────────────────────────────────────────────────────
# Une seule des deux clés suffit. Tenor est essayé en premier.
# Sans clé, le bouton GIF reste visible et explique qu'il n'est pas
# configuré — aucune requête n'est faite.
TENOR_API_KEY=
GIPHY_API_KEY=

# Origine publique exacte en production, utilisée par le retour OAuth
# (ex. https://devnet.example.com). En développement, détection automatique.
APP_PUBLIC_ORIGIN=

# ── Emails transactionnels ────────────────────────────────
# Sans aucune de ces variables, « mot de passe oublié » refuse honnêtement
# l'envoi au lieu d'annoncer un email qui n'existe pas.
#
# EmailJS est essayé en premier dès que les trois premières valeurs sont
# présentes. Le modèle est défini dans le tableau de bord et reçoit
# `to_email`, `reset_url` et `expires_minutes`. Il faut autoriser les
# appels hors navigateur (Account → Security → API access), sinon EmailJS
# répond 403.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
# Recommandée : sans elle, la clé publique seule suffit à envoyer.
EMAILJS_PRIVATE_KEY=

# Repli Resend. `EMAIL_FROM` doit être un expéditeur vérifié dans Resend.
RESEND_API_KEY=
EMAIL_FROM=

# ── Stockage des médias (Cloudflare R2, compatible S3) ─────────────
# 10 Go gratuits, sans frais de sortie. Sans ces variables, les médias
# restent dans PostgreSQL (`public.media_files`) et l'app continue de
# fonctionner. `R2_PUBLIC_URL` est le domaine public du bucket (r2.dev
# ou domaine personnalisé), sans barre oblique finale.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
# Facultatif : endpoint S3 complet pour un autre fournisseur compatible.
R2_ENDPOINT=
