# Modèle de configuration — copiez vers .env.local
#
#   cp .env.example .env.local
#
# Next.js lit `.env.local` en priorité ; les scripts `db:*` lisent le même
# fichier. Aucun secret ne va dans Git : seuls les gabarits sont versionnés.

# ── Base de données (PostgreSQL direct) ─────────────────────────────
# Cible par défaut : le conteneur de docker-compose.yml (port 5433 en
# façade). En production, mettez ici l'URL fournie par l'hébergeur, avec
# `?sslmode=require` si le serveur l'exige. Les scripts db:* refusent
# d'effacer une base dont l'hôte n'est pas local.
DATABASE_URL=postgres://devnet:devnet@127.0.0.1:5433/devnet

# Certificat d'autorité du serveur, pour `sslmode=verify-full` : contenu PEM
# ou chemin d'un fichier. Sans lui, `require` chiffre sans prouver l'identité
# du serveur ; `disable` est refusé vers un hôte distant.
DATABASE_CA_CERT=

# local (défaut) ou remote. Une écriture distante exige en plus
# CONFIRM_REMOTE=<nom exact de la base>. Ne jamais mettre `remote` en CI.
DB_TARGET=local
CONFIRM_REMOTE=

# ── Drainage des événements (Phase 3) ───────────────────────────────
# Secret porteur du planificateur : Authorization: Bearer <valeur>.
# Sans ce secret, seul un utilisateur connecté peut déclencher le drainage.
EVENTS_DRAIN_SECRET=
# true coupe tous les plugins d'un coup, sans redéploiement.
PLUGINS_DISABLED=false

# ── Mode démonstration ──────────────────────────────────────────────
# true : l'application démarre sans backend, données en mémoire.
NEXT_PUBLIC_FORCE_DEMO=false

# ── OAuth GitHub (facultatif : seul le groupe /api/github en dépend) ─
NEXT_PUBLIC_GITHUB_CLIENT_ID=
# Secrets serveur uniquement.
GITHUB_CLIENT_SECRET=
# 32 caractères minimum ; chiffre le jeton GitHub dans le cookie.
GITHUB_CRYPT_KEY=
# Date ISO 8601 de fin de la période de grâce des anciens cookies (format v1).
GITHUB_CRYPT_LEGACY_UNTIL=2026-12-04T00:00:00.000Z

# ── GIF ─────────────────────────────────────────────────────────────
# Une seule des deux clés suffit. Tenor est essayé en premier.
# Sans clé, le bouton GIF reste visible et explique qu'il n'est pas
# configuré — aucune requête n'est faite.
TENOR_API_KEY=
GIPHY_API_KEY=

# Origine publique exacte en production, utilisée par le retour OAuth
# (ex. https://devnet.example.com). En développement, détection automatique.
APP_PUBLIC_ORIGIN=

# ── LEGACY — Supabase (en cours de retrait, Phases 5 et 6) ──────────
# Ces variables ne sont plus nécessaires dès que l'authentification et les
# dépôts passent par PostgreSQL direct. Elles restent listées tant que
# `@supabase/*` est dans package.json ; le jour où elles disparaissent du
# code, supprimez ce bloc.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé de service — côté serveur uniquement, jamais préfixée NEXT_PUBLIC_.
# Sert à une seule route aujourd'hui : /api/admin/accounts.
SUPABASE_SERVICE_ROLE_KEY=
