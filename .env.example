# Modèle de configuration — copiez vers .env.local
#
#   cp .env.example .env.local
#
# Next.js lit `.env.local` en priorité ; les scripts `db:*` lisent le même
# fichier. Aucun secret ne va dans Git : seuls les gabarits sont versionnés.

# ── Base de données (PostgreSQL direct) ─────────────────────────────
# Cible par défaut : le conteneur de docker-compose.yml (port 5433 en
# façade). En production, mettez ici l'URL fournie par l'hébergeur, avec
# `?sslmode=require` si le serveur l'exige. Les scripts db:* refusent
# d'effacer une base dont l'hôte n'est pas local.
DATABASE_URL=postgres://devnet:devnet@127.0.0.1:5433/devnet

# Certificat d'autorité du serveur, pour `sslmode=verify-full` : contenu PEM
# ou chemin d'un fichier. Sans lui, `require` chiffre sans prouver l'identité
# du serveur ; `disable` est refusé vers un hôte distant.
DATABASE_CA_CERT=

# Base de secours de la bascule automatique (voir docs/ops/failover.md).
# Absente = aucune bascule possible : /api/ready reste `degraded` si la
# primaire tombe, ce qui est la vérité. Pour la sauvegarde nocturne, préférer
# DATABASE_URL_STANDBY_UNPOOLED (URL directe : pg_dump ne passe pas un pooler).
DATABASE_URL_STANDBY=
DATABASE_URL_STANDBY_UNPOOLED=

# auto (défaut) ou off. `off` laisse la primaire seule maîtresse.
DATABASE_FAILOVER=auto

# Échappatoire explicite quand l'hébergeur n'offre pas TLS (Systalink annonce
# aujourd'hui « Mode SSL : disable »). À `true`, un hôte distant sans
# `sslmode` — ou avec `sslmode=disable` — se connecte en clair : le mot de
# passe traverse le réseau lisible. À n'activer qu'après l'échec constaté
# « The server does not support SSL connections », et à retirer dès que
# l'hébergeur propose TLS.
DATABASE_TLS_INSECURE=false

# local (défaut) ou remote. Une écriture distante exige en plus
# CONFIRM_REMOTE=<nom exact de la base>. Ne jamais mettre `remote` en CI.
DB_TARGET=local

# ── Budgets de requête (côté serveur, pas seulement côté client) ────
# `query_timeout` de `pg` abandonne le client, mais le serveur continue
# d'exécuter la requête. Sans plafond serveur, une requête lente occupe une
# connexion du pool indéfiniment : sur 10 connexions par instance, c'est une
# fuite silencieuse. Ces trois valeurs sont posées sur chaque connexion du
# pool via `options`, donc le serveur tranche lui-même (erreur 57014).
# Le plafond serveur est un peu au-dessus du plafond client pour que
# l'erreur remonte explicite plutôt qu'un client qui raccroche sans que le
# serveur le sache. Les migrations gardent leur propre budget.
# Établissement d'une connexion. 4 s : au-delà, la base est considérée
# muette et la bascule est tentée. Sans cette borne, une base qui accepte
# le TCP puis ne répond plus immobilise la première requête 10 s.
PG_CONNECT_TIMEOUT_MS=4000
PG_QUERY_TIMEOUT_MS=15000
PG_STATEMENT_TIMEOUT_MS=20000
PG_LOCK_TIMEOUT_MS=5000
CONFIRM_REMOTE=

# ── Drainage des événements (Phase 3) ───────────────────────────────
# Secret porteur du planificateur : Authorization: Bearer <valeur>.
# Sans ce secret, seul un utilisateur connecté peut déclencher le drainage.
# Protège /api/cron/purge-media. Vercel Cron envoie
# `Authorization: Bearer $CRON_SECRET`. Sans valeur, la route répond 503.
CRON_SECRET=
EVENTS_DRAIN_SECRET=
# true coupe tous les plugins d'un coup, sans redéploiement.
PLUGINS_DISABLED=false

# ── Mode démonstration ──────────────────────────────────────────────
# true : l'application démarre sans backend, données en mémoire.
NEXT_PUBLIC_FORCE_DEMO=false

# ── OAuth GitHub (facultatif : seul le groupe /api/github en dépend) ─
NEXT_PUBLIC_GITHUB_CLIENT_ID=
# Secrets serveur uniquement.
GITHUB_CLIENT_SECRET=
# 32 caractères minimum ; chiffre le jeton GitHub dans le cookie.
GITHUB_CRYPT_KEY=
# Date ISO 8601 de fin de la période de grâce des anciens cookies (format v1).
GITHUB_CRYPT_LEGACY_UNTIL=2026-12-04T00:00:00.000Z

# ── Connexion OAuth Google / GitHub ────────────────────────────────
# Secrets serveur uniquement. Sans ces valeurs, /login affiche les boutons
# puis explique que la connexion externe n'est pas configurée.
# Callbacks à déclarer chez chaque fournisseur :
#   Google : https://<origine>/api/auth/oauth/google/callback
#   GitHub : https://<origine>/api/auth/oauth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OAuth App GitHub dédiée à la connexion (distincte de la liaison de dépôts).
GITHUB_LOGIN_CLIENT_ID=
GITHUB_LOGIN_CLIENT_SECRET=
# 32 caractères minimum ; signe le `state` OAuth (HMAC-SHA-256).
AUTH_OAUTH_SECRET=

# ── GIF ─────────────────────────────────────────────────────────────
# Une seule des deux clés suffit. Tenor est essayé en premier.
# Sans clé, le bouton GIF reste visible et explique qu'il n'est pas
# configuré — aucune requête n'est faite.
TENOR_API_KEY=
GIPHY_API_KEY=

# Origine publique exacte en production, utilisée par le retour OAuth
# (ex. https://devnet.example.com). En développement, détection automatique.
APP_PUBLIC_ORIGIN=

# ── Emails transactionnels ────────────────────────────────
# Sans aucune de ces variables, « mot de passe oublié » refuse honnêtement
# l'envoi au lieu d'annoncer un email qui n'existe pas.
#
# EmailJS est essayé en premier dès que les trois premières valeurs sont
# présentes. Le modèle est défini dans le tableau de bord et reçoit
# `to_email`, `reset_url` et `expires_minutes`. Il faut autoriser les
# appels hors navigateur (Account → Security → API access), sinon EmailJS
# répond 403.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
# Recommandée : sans elle, la clé publique seule suffit à envoyer.
EMAILJS_PRIVATE_KEY=

# Repli Resend. `EMAIL_FROM` doit être un expéditeur vérifié dans Resend.
RESEND_API_KEY=
EMAIL_FROM=

# ── Notifications poussées (Web Push / VAPID) ──────────────────────
# Permettent d'avertir un appareil même écran verrouillé. Sans ces clés,
# le reste de l'application fonctionne : le serveur ne pousse rien et les
# réglages expliquent que l'alerte à distance n'est pas disponible.
#
# Générer une paire une seule fois :
#   npx web-push generate-vapid-keys
# puis coller les deux clés ci-dessous. `VAPID_SUBJECT` est un contact
# (mailto: ou https:) que les services de push utilisent en cas d'abus.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@devnet.local

# ── Stockage des médias (Cloudflare R2, compatible S3) ─────────────
# 10 Go gratuits, sans frais de sortie. Sans ces variables, les médias
# restent dans PostgreSQL (`public.media_files`) et l'app continue de
# fonctionner. `R2_PUBLIC_URL` est le domaine public du bucket (r2.dev
# ou domaine personnalisé), sans barre oblique finale.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
# Facultatif : endpoint S3 complet pour un autre fournisseur compatible.
R2_ENDPOINT=

# ── Bascule : retour automatique ───────────────────────────────────
# `manual` (défaut) : une primaire qui revient est détectée, mais le retour
# se décide depuis /admin/data. C'est le choix sûr — revenir abandonne les
# écritures faites sur la secours pendant l'incident, et une empreinte de
# schéma identique ne dit rien des lignes.
# `auto` : retour automatique dès que la primaire répond et que son schéma
# est identique. À réserver aux installations qui répliquent réellement les
# données.
FAILOVER_AUTO_RETURN=manual

# ── Modération ─────────────────────────────────────────────────────
# `auto` (défaut) : insultes, haine, sexuel et menaces refusent ; arnaques,
# drogues et appels à l'aide passent en file de relecture.
# `block` : tout terme trouvé refuse la publication.
# `off` : aucun refus, tout est signalé.
MODERATION_STRICT=auto

# Sel des empreintes d'adresses IP et d'identifiants dans `security_events`.
# Sans lui, `AUTH_OAUTH_SECRET` est réutilisé ; en dernier recours une
# constante de développement (les empreintes ne sont alors pas corrélables
# entre installations, mais aucune IP n'est stockée en clair).
SECURITY_HASH_SECRET=

# ── Réencodage vidéo côté serveur ──────────────────────────────────
# `auto` (défaut) : utilise `ffmpeg` s'il est présent, sinon le client
# prépare la vidéo (`lib/video-compat.ts`). `off` : jamais de réencodage
# serveur — utile si l'hôte n'a pas de CPU à y consacrer.
MEDIA_TRANSCODE=auto
