      "language": "typescript",
      "prefix": "dhook",
      "body": [
        "export function use${1:Feature}() {",
        "  const [${2:data}, setData] = useState<${3:unknown}[]>([]);",
        "",
        "  useEffect(() => {",
        "    let alive = true;",
        "    fetch${1:Feature}().then((rows) => {",
        "      if (alive) setData(rows);",
        "    });",
        "    return () => { alive = false; };",
        "  }, []);",
        "",
        "  return { ${2:data} };",
        "}"
      ],
      "description": "Hook de données avec cleanup"
    },
