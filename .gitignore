# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# journaux du serveur de démo
dev-server.log
*.log

# captures d'écran de diagnostic
*.png

# ressources PWA versionnées (manifeste)
!public/icons/
!public/icons/*.png
!public/splash/
!public/splash/*.png
!public/screenshots/
!public/screenshots/*.png

# état local de Supabase (secrets, cache CLI, dump de la base locale)
/supabase/.temp/
/supabase/seed.sql

# artefacts de diagnostic locaux
/.tmp-logo/
*.pid
tunnel-url.txt
__pycache__/
*.pyc

# Exploitation locale : ne remonte jamais au dépôt
/goose-*
/alphacode/
/*.log
/*.pid
/tunnel-url.txt
/docs-technique.pdf
/Capture*.png
/parcours-*.png

# Notes de travail locales — jamais versionnées. Les documents du dépôt
# (`README.md`, `docs/**/*.md`, etc.) doivent rester versionnés : ignorer
# globalement `*.md` masquait aussi les nouveaux documents d'ingénierie.
/knowledge.md
/devnet_status.md
/docs-technique.md

# Outils de développement locaux : recréés par les éditeurs, jamais versionnés
AGENTS.md
CLAUDE.md
.agents/
.claude/
.freebuff/

# Portes navigateur : artefacts Playwright (traces, rapports)
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
.neon

# Sauvegardes de base : contiennent des données personnelles (emails, hachages
# de mots de passe). Jamais dans Git, même dans un dépôt privé. Les dumps
# vivent hors du dépôt (~/.devnet-backups, permissions 600).
/backups/
*.dump
*.sql.gz
