# Copiez ce fichier vers .env.local puis renseignez DATABASE_URL.
# L'application n'utilise plus Supabase : tout passe par PostgreSQL.
# Force le mode démonstration sans backend (true pour la démo hors-ligne)
NEXT_PUBLIC_FORCE_DEMO=false

# PostgreSQL 17 local (scripts de migration uniquement ; l'application n'y
# envoie pas encore ses requêtes). Démarrer avec `docker-compose up -d db`.
DATABASE_URL=postgresql://devnet:devnet@127.0.0.1:5433/devnet

# ── Connexion OAuth Google / GitHub ────────────────────────────────
# Secrets serveur uniquement. Sans ces valeurs, /login affiche les boutons
# puis explique que la connexion externe n'est pas configurée.
# Callbacks à déclarer chez chaque fournisseur :
#   Google : https://<origine>/api/auth/oauth/google/callback
#   GitHub : https://<origine>/api/auth/oauth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OAuth App GitHub dédiée à la connexion (distincte de la liaison de dépôts).
GITHUB_LOGIN_CLIENT_ID=
GITHUB_LOGIN_CLIENT_SECRET=
# 32 caractères minimum ; signe le `state` OAuth (HMAC-SHA-256).
AUTH_OAUTH_SECRET=

# OAuth GitHub (optionnel)
NEXT_PUBLIC_GITHUB_CLIENT_ID=
# Secrets serveur uniquement ; GITHUB_CRYPT_KEY doit compter au moins 32 caractères.
GITHUB_CLIENT_SECRET=
GITHUB_CRYPT_KEY=

# Origine publique exacte du site en production (utilisée par le callback OAuth GitHub).
# Ex. https://devnet.example.com — en développement, les tunnels restent détectés automatiquement.
APP_PUBLIC_ORIGIN=

# Date limite ISO 8601 UTC pour déchiffrer les anciens cookies GitHub (format v1).
# Après cette date, les utilisateurs reconnectent GitHub pour obtenir un cookie v2.
GITHUB_CRYPT_LEGACY_UNTIL=2026-12-04T00:00:00.000Z
